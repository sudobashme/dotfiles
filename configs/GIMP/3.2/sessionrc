# GIMP sessionrc
# 
# This file takes session-specific info (that is info, you want to keep
# between two GIMP sessions).  You are not supposed to edit it manually, but
# of course you can do.  The sessionrc will be entirely rewritten every time
# you quit GIMP.  If this file isn't found, defaults are used.

(session-info "toplevel"
    (factory-entry "gimp-empty-image-window")
    (position 691 92)
    (size 640 480))
(session-info "toplevel"
    (factory-entry "gimp-single-image-window")
    (position 355 30)
    (size 3485 1422)
    (open-on-exit)
    (aux-info
        (left-docks-width "651")
        (right-docks-width "605")
        (maximized "no"))
    (gimp-toolbox
        (side left))
    (gimp-dock
        (side left)
        (position 133)
        (book
            (current-page 0)
            (dockable "gimp-tool-options"
                (tab-style preview)
                (aux-info
                    (show-button-bar "true")))))
    (gimp-dock
        (side right)
        (book
            (current-page 7)
            (dockable "gimp-brush-grid"
                (tab-style icon)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-pattern-grid"
                (tab-style icon)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-font-list"
                (tab-style icon)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-document-list"
                (tab-style icon)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-dynamics-list"
                (tab-style preview)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-mypaint-brush-grid"
                (tab-style preview)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-path-list"
                (tab-style icon)
                (preview-size 32)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-selection-editor"
                (tab-style icon)
                (aux-info
                    (show-button-bar "true"))))
        (book
            (position 614)
            (current-page 0)
            (dockable "gimp-layer-list"
                (tab-style icon)
                (preview-size 32)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-channel-list"
                (tab-style icon)
                (preview-size 32)
                (aux-info
                    (show-button-bar "true")))
            (dockable "gimp-path-list"
                (tab-style icon)
                (preview-size 32)
                (aux-info
                    (show-button-bar "true"))))))
(session-info "toplevel"
    (factory-entry "gimp-input-devices-dialog")
    (position 54 30))
(session-info "toplevel"
    (factory-entry "gimp-file-export-dialog")
    (position 58 30)
    (size 898 603))
(session-info "toplevel"
    (factory-entry "gimp-file-open-dialog")
    (position 59 30)
    (size 898 603))
(session-info "toplevel"
    (factory-entry "gimp-preferences-dialog")
    (position 271 289)
    (size 840 531))
(session-info "toplevel"
    (factory-entry "gimp-image-new-dialog")
    (position 2080 30))
(session-info "toplevel"
    (factory-entry "gimp-toolbox-color-dialog")
    (position 2322 538))
(session-info "toplevel"
    (factory-entry "gimp-operation-tool-dialog")
    (position 570 30))
(session-info "toplevel"
    (factory-entry "gimp-file-save-dialog")
    (position 59 30)
    (size 898 603))
(session-info "toplevel"
    (factory-entry "gimp-image-new-dialog")
    (position 752 180))

(hide-docks no)
(single-window-mode yes)
(show-tabs yes)
(tabs-position 1)
(last-tip-shown 0)

# end of sessionrc
