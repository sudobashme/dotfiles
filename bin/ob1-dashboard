#!/usr/bin/env zsh
set -euo pipefail

readonly OB1_REPO_URL="https://github.com/sudobashme/OB1.git"
readonly OB1_BRANCH="codex/openbrain-attention-dashboard"
readonly OB1_CHECKOUT="${OB1_DASHBOARD_CHECKOUT:-${HOME}/.local/share/ob1-dashboard}"
readonly OB1_APP="${OB1_CHECKOUT}/dashboards/open-brain-dashboard-next"
readonly OB1_CONFIG_DIR="${HOME}/.config/ob1-dashboard"
readonly OB1_SESSION_SECRET="${OB1_CONFIG_DIR}/session-secret"
readonly OB1_PLIST="${HOME}/Library/LaunchAgents/com.sudobashme.ob1-dashboard.plist"
readonly OB1_LABEL="com.sudobashme.ob1-dashboard"
readonly OB1_REST_URL="https://fyuyuyjtdfrixfgfdtqs.supabase.co/functions/v1/open-brain-rest"
readonly OB1_MEMORY_URL="https://fyuyuyjtdfrixfgfdtqs.supabase.co/functions/v1/agent-memory-api"
readonly OB1_TAILSCALE_URL="https://shawns-mac-mini.tailb425d7.ts.net:8443"

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

usage() {
    cat <<EOF
Usage: ob1-dashboard <setup|serve|start|stop|restart|status|update|open|url>

  setup    Clone/build the pinned fork branch, install launchd, and configure Tailscale Serve
  serve    Run the production dashboard on 127.0.0.1:3010 (used by launchd)
  start    Start the installed launchd service
  stop     Stop the installed launchd service
  restart  Restart the installed launchd service
  status   Show launchd, local HTTP, and Tailscale status
  update   Fast-forward the pinned branch, rebuild, and restart
  open     Open the tailnet-only dashboard URL
  url      Print the tailnet-only dashboard URL
EOF
}

need() {
    command -v "$1" >/dev/null 2>&1 || {
        print -u2 "ob1-dashboard: missing required command: $1"
        return 1
    }
}

write_plist() {
    mkdir -p "${OB1_PLIST:h}"
    cat >| "${OB1_PLIST}" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>${OB1_LABEL}</string>
  <key>ProgramArguments</key>
  <array>
    <string>${HOME}/.local/bin/ob1-dashboard</string>
    <string>serve</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
EOF
    plutil -lint "${OB1_PLIST}" >/dev/null
}

ensure_secret() {
    mkdir -p "${OB1_CONFIG_DIR}"
    chmod 700 "${OB1_CONFIG_DIR}"
    if [[ ! -s "${OB1_SESSION_SECRET}" ]]; then
        openssl rand -hex 32 >| "${OB1_SESSION_SECRET}"
        chmod 600 "${OB1_SESSION_SECRET}"
    fi
}

build_app() {
    (
        cd "${OB1_APP}"
        npm ci
        NEXT_PUBLIC_API_URL="${OB1_REST_URL}" \
        AGENT_MEMORY_API_URL="${OB1_MEMORY_URL}" \
        AGENT_MEMORY_WORKSPACE_ID="personal" \
        SESSION_SECRET="$(<"${OB1_SESSION_SECRET}")" \
        AUTH_COOKIE_SECURE="true" \
        NEXT_PUBLIC_APP_URL="${OB1_TAILSCALE_URL}" \
        npm run build
    )
}

install_checkout() {
    mkdir -p "${OB1_CHECKOUT:h}"
    if [[ ! -d "${OB1_CHECKOUT}/.git" ]]; then
        git clone --branch "${OB1_BRANCH}" --single-branch "${OB1_REPO_URL}" "${OB1_CHECKOUT}"
    else
        local actual_origin
        actual_origin="$(git -C "${OB1_CHECKOUT}" remote get-url origin)"
        [[ "${actual_origin}" == "${OB1_REPO_URL}" ]] || {
            print -u2 "ob1-dashboard: refusing unexpected checkout origin: ${actual_origin}"
            return 1
        }
    fi
}

service_stop() {
    launchctl bootout "gui/${UID}/${OB1_LABEL}" >/dev/null 2>&1 || true
}

service_start() {
    [[ -f "${OB1_PLIST}" ]] || {
        print -u2 "ob1-dashboard: run setup first"
        return 1
    }
    launchctl bootstrap "gui/${UID}" "${OB1_PLIST}"
}

case "${1:-}" in
    setup)
        need git; need npm; need openssl; need tailscale; need launchctl
        install_checkout
        ensure_secret
        build_app
        write_plist
        service_stop
        service_start
        tailscale serve --bg --https=8443 localhost:3010
        print -r -- "Open Brain Dashboard is available at ${OB1_TAILSCALE_URL}"
        ;;
    serve)
        ensure_secret
        cd "${OB1_APP}"
        export NEXT_PUBLIC_API_URL="${OB1_REST_URL}"
        export AGENT_MEMORY_API_URL="${OB1_MEMORY_URL}"
        export AGENT_MEMORY_WORKSPACE_ID="personal"
        export SESSION_SECRET="$(<"${OB1_SESSION_SECRET}")"
        export AUTH_COOKIE_SECURE="true"
        export NEXT_PUBLIC_APP_URL="${OB1_TAILSCALE_URL}"
        exec npm run start -- --hostname 127.0.0.1 --port 3010
        ;;
    start) service_start ;;
    stop) service_stop ;;
    restart) service_stop; service_start ;;
    update)
        install_checkout
        ensure_secret
        git -C "${OB1_CHECKOUT}" diff --quiet
        git -C "${OB1_CHECKOUT}" pull --ff-only origin "${OB1_BRANCH}"
        build_app
        service_stop
        service_start
        ;;
    status)
        launchctl print "gui/${UID}/${OB1_LABEL}" >/dev/null 2>&1 \
            && print -r -- "launchd: running" \
            || print -r -- "launchd: stopped"
        curl -fsS http://127.0.0.1:3010/login >/dev/null 2>&1 \
            && print -r -- "local: ready on 127.0.0.1:3010" \
            || print -r -- "local: unavailable"
        tailscale serve status
        ;;
    open) open "${OB1_TAILSCALE_URL}" ;;
    url) print -r -- "${OB1_TAILSCALE_URL}" ;;
    -h|--help|help|"") usage ;;
    *) print -u2 "ob1-dashboard: unknown command: $1"; usage >&2; exit 1 ;;
esac
