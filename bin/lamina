#!/usr/bin/env zsh
# Lamina — Personal OS Layer deploy and health CLI
set -euo pipefail

LAMINA_BIN="${0:A}"
DOTFILES="${LAMINA_BIN:h:h}"
LAMINA_LIB="${DOTFILES}/lamina/lib"
LAMINA_DIR="${DOTFILES}/lamina"

source "${LAMINA_LIB}/common.zsh"

usage() {
    cat <<'EOF'
lamina — Personal OS Layer deploy and health

Usage:
  lamina deploy [--dry-run] [--symlinks-only]
                              Apply symlinks + sync zsh plugins
  lamina sync-plugins [--dry-run] [--no-zrecompile]
                              Sync zsh plugins from lamina/plugins.toml
  lamina update [--check] [--full] [--no-pull] [--no-nvim]
                              Pull dotfiles, deploy, Lazy sync, TSUpdate (+ optional brew/npm)
  lamina health               Check for drift, strays, plugins, and symlinks
  lamina diff                 Show symlink changes (dotter dry-run)
  lamina repair               Repair symlinks + resync plugins

Options passed to deploy/diff are forwarded to dotter.
EOF
}

cmd="${1:-}"
shift || true

case "${cmd}" in
    deploy)
        LAMINA_DEPLOY_MODE=deploy source "${LAMINA_DIR}/deploy.zsh" "$@"
        ;;
    repair)
        LAMINA_DEPLOY_MODE=repair source "${LAMINA_DIR}/deploy.zsh" "$@"
        ;;
    sync-plugins|plugins)
        typeset -a sync_args
        sync_args=()
        for arg in "$@"; do
            case "${arg}" in
                --dry-run) export LAMINA_PLUGINS_DRY_RUN=1 ;;
                --no-zrecompile) export LAMINA_PLUGINS_NO_ZRECOMPILE=1 ;;
                *) sync_args+=("${arg}") ;;
            esac
        done
        if [[ -n "${sync_args[*]:-}" ]]; then
            print -u2 "lamina: unknown sync-plugins args: ${sync_args[*]}"
            exit 1
        fi
        source "${LAMINA_DIR}/hooks/sync-plugins.zsh"
        ;;
    update|up)
        source "${LAMINA_DIR}/update.zsh" "$@"
        ;;
    health|check)
        source "${LAMINA_DIR}/health.zsh"
        ;;
    diff)
        (
            cd "${DOTFILES}" || exit 1
            dotter deploy --dry-run -v "$@"
        )
        ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        print -u2 "lamina: unknown command: ${cmd}"
        usage >&2
        exit 1
        ;;
esac