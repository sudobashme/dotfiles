#!/usr/bin/env zsh
# Launch a Grok pane from the current tmux session.
# Falls back to plain Grok when not inside tmux.

set -euo pipefail

GROK="${HOME}/.grok/bin/grok"

if [[ ! -x "$GROK" ]]; then
  echo "Error: grok not found at $GROK" >&2
  exit 1
fi

if [[ -n "${TMUX:-}" ]]; then
  tmux split-window -h -c "#{pane_current_path}" "$GROK"
  tmux select-pane -t "${TMUX_PANE}"
else
  echo "Not inside tmux."
  exec "$GROK"
fi
